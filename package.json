{
  "name": "medical-store-billing",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:frontend": "npm.cmd --prefix frontend run dev",
    "dev:backend": "npm.cmd --prefix backend run dev",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File start-dev.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File stop-dev.ps1",
    "build": "npm.cmd --prefix frontend run build && npm.cmd --prefix backend run build",
    "build:frontend": "npm.cmd --prefix frontend run build",
    "build:backend": "npm.cmd --prefix backend run build",
    "start:backend": "npm.cmd --prefix backend start"
  }
}
